# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요.
# 비워두면 앱이 '로컬 모드'(이 브라우저에만 저장)로 동작합니다.
#
# Supabase 대시보드 → Project Settings → API (또는 Connect 버튼) 에서 확인
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable key (sb_publishable_...) 또는 예전 anon key — 공개돼도 되는 키입니다.
# 절대 service_role / secret key 를 넣지 마세요.
VITE_SUPABASE_KEY=
